####### Profile Options #######
# Select docker compose profile to use
# netboot:
#  - Only runs TFTP and NFS Servers
# debian-netboot:
#  - Runs TFTP and NFS Servers
#  - Downloads specified DOWNLOAD_LINK SD Image and extracts files to NFS and TFTP shares
# debian-sdcard:
#  - Does not run TFTP and NFS Servers
#  - Downloads specified DOWNLOAD_LINK SD Image and extracts files to NFS and TFTP shares
COMPOSE_PROFILE=debian-netboot

####### Select Raspberry Pi OS version to download #######
## Ubuntu Server 24.04
DOWNLOAD_LINK=https://cdimage.ubuntu.com/releases/24.04/release/ubuntu-24.04.3-preinstalled-server-arm64+raspi.img.xz
ASSETS_DIR=ubuntuserver

## RaspiOS Min
# DOWNLOAD_LINK=https://downloads.raspberrypi.com/raspios_lite_arm64/images/raspios_lite_arm64-2023-12-11/2023-12-11-raspios-bookworm-arm64-lite.img.xz
# ASSETS_DIR=raspios

## RaspiOS
# DOWNLOAD_LINK=https://downloads.raspberrypi.com/raspios_arm64/images/raspios_arm64-2023-12-06/2023-12-05-raspios-bookworm-arm64.img.xz
# ASSETS_DIR=raspios

## RaspiOS Full
# DOWNLOAD_LINK=https://downloads.raspberrypi.com/raspios_full_arm64/images/raspios_full_arm64-2023-12-06/2023-12-05-raspios-bookworm-arm64-full.img.xz
# ASSETS_DIR=raspios

####### General Options #######
# Should boot files be cleaned before building new ones
CLEAN_BOOT_FILES=true
# Should OS files be cleaned before building new ones
CLEAN_OS_FILES=false

####### Rebuild Options #######
# Force re-extraction of the downloaded image even if an extracted artifact exists
FORCE_REEXTRACT=false

####### VM Settings #######
VM_OS="22.04"
VM_NAME="netboot-$COMPOSE_PROFILE-vm"
VM_CPUS="8"
VM_MEMORY="4G"
VM_DISK="15G"
VM_REBUILD=false
# The host network the VM bridges onto, as `multipass networks` names it; it
# must be the Pis' LAN. Default: the first wired one.
# VM_NETWORK="Ethernet 2"

####### NFS Server #######
NFS_VERSION=3
NFS_EXPORT_0="/mnt/nfsshare *(ro,fsid=0,async,no_subtree_check,no_auth_nlm,insecure,no_root_squash)"
NFS_LOG_LEVEL=DEBUG

####### Network Options #######
BOOTSTRAP_IP_ADDRESS=192.168.1.66

####### Pis (rebootstrap.sh) #######
# PI_HOSTS="192.168.1.50 192.168.1.51 192.168.1.52"
# PI_USER=ubuntu

####### ainur secrets #######
# Never in git, never served, never in an image: pi-secrets-pusher reads this
# file every 30s and SSHes the AINUR_*/ARDA_* values to ainur, which keeps
# them as its ainur-secrets and arda-secrets Secrets.
# Single-quote anything with a $ in it (the Dex hash).
# The only way into the Pis (they have no password): an SSH key pair. The
# images trust the public half; the pushers and rebootstrap.sh use the private.
#   ssh-keygen -q -t ed25519 -N "" -C ainur-push -f push
#   AINUR_PUSH_KEY=<output of: base64 -w0 push>
#   AINUR_PUSH_PUBKEY='<contents of push.pub>'
AINUR_PUSH_KEY=
AINUR_PUSH_PUBKEY=''
# k3s join tokens, server and agent
AINUR_K3S_TOKEN=
AINUR_K3S_AGENT_TOKEN=
# Your admin password, set with scripts/set-admin-password.sh (not by hand),
# which writes both: ntfy's admin takes its bcrypt hash, and LLDAP's admin
# (your Dex login, user admin) the password itself, AINUR_LLDAP_ADMIN_PASSWORD
# below.
AINUR_DEX_ADMIN_HASH=''
# The OIDC client secret Dex shares with Argo CD, Headlamp, Omni and Homepage
AINUR_OIDC_CLIENT_SECRET=
# The key every sign-in proxy's cookie (oauth2-proxy, both clusters),
# Transmute's sessions and admin password, and CrowdSec's LAPI/bouncer keys
# are derived from. Its own independent random value, separate from
# AINUR_OIDC_CLIENT_SECRET. Any long random string; changing it signs everyone
# out.
AINUR_SSO_SECRET=
# The token Alertmanager posts to ntfy with: tk_ and 29 lowercase letters or
# digits. Your own ntfy login is admin with your Dex password.
AINUR_NTFY_TOKEN=
# LLDAP, the lab's users and groups behind Dex (src/manifests/ainur/dex/lldap.yaml):
# the password of its admin (user admin: you, in Dex and at lldap.kidd.network;
# set by scripts/set-admin-password.sh), that of the
# read-only account Dex looks people up with, and its session and password
# keys. Any long random strings; the key seed must never change once set
# (it encrypts the stored passwords).
AINUR_LLDAP_ADMIN_PASSWORD=
AINUR_LLDAP_DEX_PASSWORD=
AINUR_LLDAP_JWT_SECRET=
AINUR_LLDAP_KEY_SEED=
# The dead man's switch: Alertmanager reschedules an alert on the public
# ntfy.sh every 10 minutes, and it fires if ainur goes quiet for 30. The topic
# is the password; make it unguessable, and subscribe to it on ntfy.sh in the
# ntfy app. All on one line, single-quoted (the &s):
#   'https://ntfy.sh/lab-<32 random hex>/heartbeat?in=30m&template=yes&title=Lab%20alerts%20are%20down&priority=5&tags=rotating_light&m=No%20heartbeat%20from%20ainur'
AINUR_DEADMAN_URL=''
# The lab root CA, so a rebuilt ainur keeps the CA your devices and the arda
# machines trust. Each is a PEM file as one line of base64 (base64 -w0).
# Empty, ainur makes a new CA on its first boot; copy that one in afterwards:
#   ssh ubuntu@192.168.1.50 'sudo base64 -w0 /etc/rancher/k3s/oidc/lab-ca.crt'
#   ssh ubuntu@192.168.1.50 'sudo base64 -w0 /etc/k3s-certs/lab-ca.key'
AINUR_LAB_CA_CRT=
AINUR_LAB_CA_KEY=

####### arda secrets #######
# Never in git. The builder serves every ARDA_* value to ainur, which keeps
# them as its arda-secrets Secret; arda-bootstrap-job.yaml hands each to its
# app on arda. Readable on the LAN while the bootstrap VM runs.
# Cloudflare account ID (zero-trust Access apps & policies)
ARDA_CLOUDFLARE_ACCOUNT_ID=
# Cloudflare API token: Zone:DNS:Edit on kidd.network (external-dns, ddns)
# and Account:Access:Apps and Policies:Edit (arda-tunnel zero-trust sync)
ARDA_CLOUDFLARE_API_TOKEN=
# Comma-separated emails (or @domain entries) allowed through Cloudflare
# Access for Ingresses annotated kidd.network/zero-trust: "true"
ARDA_CLOUDFLARE_ACCESS_EMAILS=
# `cloudflared tunnel token arda`
ARDA_CLOUDFLARE_TUNNEL_TOKEN=
# Minecraft UUIDs, comma-separated with no spaces: who may join survival,
# and who may build on creative
ARDA_MINECRAFT_WHITELIST=
ARDA_MINECRAFT_BUILDERS=
# Dragonwilds: the owner's Player ID, the Server Management password, and the
# password for joining. Leave it empty and the world is open to anyone: the
# server rewrites its settings from these on every start.
ARDA_DRAGONWILDS_OWNER_ID=
ARDA_DRAGONWILDS_ADMIN_PASSWORD=
ARDA_DRAGONWILDS_WORLD_PASSWORD=
# arda's volume backups (VolSync) to the arda-backups R2 bucket: an R2 API token's ID, the
# SHA-256 of its value, and https://<account id>.r2.cloudflarestorage.com
ARDA_BACKUP_ACCESS_KEY_ID=
ARDA_BACKUP_SECRET_ACCESS_KEY=
ARDA_BACKUP_ENDPOINT=
# The router's port forwards to arda's games, kept by ainur's
# unifi CronJob: a UniFi OS API key (Settings > Control Plane >
# Integrations), and the console's address if it isn't https://192.168.1.1
ARDA_UNIFI_API_KEY=
ARDA_UNIFI_URL=
# The restic password for every arda volume's backups (VolSync, to Google
# Drive with ARDA_GDRIVE_TOKEN, else the arda-backups R2 bucket with the
# ARDA_BACKUP_* keys). Any long random string; lose it and every backup is
# unreadable, so keep a copy somewhere else.
ARDA_VOLSYNC_PASSWORD=
# Optional: arda's volume backups on Google Drive instead of R2. The token
# from `rclone authorize "drive" <client id> <client secret>
# "eyJzY29wZSI6ImRyaXZlLmZpbGUifQ"` (scope drive.file: rclone sees only what
# it made), in single quotes. The client ID and secret are your own Google
# Cloud OAuth client (Drive API, consent screen published), as rclone's shared
# one is being retired; left empty, rclone's own is used while it lasts.
ARDA_GDRIVE_TOKEN=
ARDA_GDRIVE_CLIENT_ID=
ARDA_GDRIVE_CLIENT_SECRET=
# The GitLab CI runner on arda (src/manifests/arda/gitlab-runner.yml): a
# runner authentication token (glrt-...) from GitLab's New runner page, or
# the one an existing runner already uses, to add arda as another of its
# managers. Its tags are set in GitLab.
ARDA_GITLAB_RUNNER_TOKEN=
# Obsidian on arda (src/manifests/arda/obsidian.yml): the password of user
# "obsidian" on the LiveSync CouchDB at obsidian-sync.kidd.network (on the
# internet). The one login outside Dex: the Obsidian apps can't do a
# browser login. Any long random string.
ARDA_OBSIDIAN_PASSWORD=
# Home Assistant on arda (src/manifests/arda/homeassistant.yml): the password
# of its owner, user "admin", which a CronJob creates through the onboarding
# API (no first-visit page). It is also the fallback login beside Dex, and
# the one the companion app can use directly. Used at onboarding only; later
# changes go through Home Assistant's profile page. Any long random string.
ARDA_HOMEASSISTANT_PASSWORD=
# Optional: the home's location in decimal degrees (e.g. 51.4779 and -0.0015),
# for sunrise/sunset, weather and presence. Kept here rather than in Git
# because the repository is public. Without them, set it on Home Assistant's
# Settings > System > General map instead.
ARDA_HOMEASSISTANT_LATITUDE=
ARDA_HOMEASSISTANT_LONGITUDE=
# Paperless-ngx on arda (src/manifests/arda/paperless.yml). Without the
# secret key nothing is handed out and Paperless waits. All three are any
# long random strings (letters and digits keep them easy to type):
#   SECRET_KEY        Django's signing key; changing it logs everyone out
#   ADMIN_PASSWORD    the "paperless" superuser, made at the first start only
#                     (later changes go through the web app). The phone apps
#                     can use it, or a Dex user's own token (docs).
#   SCANNER_PASSWORD  user "scanner" on the SMB share \\192.168.1.58\scan, for
#                     a scanner's scan-to-folder. Keep it short enough to
#                     type on a scanner's panel, e.g. 20 characters.
ARDA_PAPERLESS_SECRET_KEY=
ARDA_PAPERLESS_ADMIN_PASSWORD=
ARDA_PAPERLESS_SCANNER_PASSWORD=
# Optional: a mailbox Paperless fetches over IMAP every 10 minutes,
# consuming PDF and image attachments in FOLDER (default INBOX) and marking
# the mails read. Use a mailbox of its own, e.g. a new Gmail address with an
# app password (imap.gmail.com); forward paperwork, or have a scanner email
# its scans there. PORT defaults to 993 (TLS); anything else is STARTTLS.
# Leave HOST empty for no mail.
ARDA_PAPERLESS_MAIL_HOST=
ARDA_PAPERLESS_MAIL_PORT=
ARDA_PAPERLESS_MAIL_USER=
ARDA_PAPERLESS_MAIL_PASSWORD=
ARDA_PAPERLESS_MAIL_FOLDER=
# The media apps on arda (src/manifests/arda/media.yml): the seed their API
# keys are derived from (Sonarr, Radarr, Prowlarr, Bazarr, Seerr), so they
# and the wiring Job agree on them. Any long random string.
ARDA_MEDIA_API_SECRET=
# Comicarr on arda (src/manifests/arda/media/comicarr.yaml): a ComicVine API
# key, which comics search needs (manga search uses MangaDex and needs none).
# Free with an account, at comicvine.gamespot.com/api. Optional.
ARDA_COMICVINE_API_KEY=
# Optional: your Letterboxd username (from letterboxd.com/<username>/). Radarr
# follows that account's watchlist: a film added there downloads itself
# (src/manifests/arda/media/letterboxd.yaml). The watchlist must be public.
ARDA_LETTERBOXD_USER=
# qBittorrent's VPN on arda (src/manifests/arda/media/qbittorrent.yaml): a
# Mullvad WireGuard key. On mullvad.net, Account → WireGuard configuration
# (Linux): generate a key, pick any server, download the .conf; from its
# [Interface], PrivateKey and Address (e.g. 10.66.12.34/32; the IPv4 one
# alone is enough). Until both are set qBittorrent never starts. Optional:
# ARDA_MULLVAD_COUNTRY, gluetun's server country (e.g. "UK", "Netherlands");
# empty, any Mullvad server.
ARDA_MULLVAD_PRIVATE_KEY=
ARDA_MULLVAD_ADDRESSES=
ARDA_MULLVAD_COUNTRY=
