#cloud-config

resize_rootfs: true

write_files:
  # Journald: per-boot (volatile) logs so journalctl works even with tmpfs /var/log
  - path: /etc/systemd/journald.conf.d/10-volatile.conf
    permissions: '0644'
    content: |
      [Journal]
      Storage=volatile
      RuntimeMaxUse=64M
      Compress=yes
      SystemMaxFileSize=16M

  # k3s tmpfs mounts preparation script
  - path: /usr/local/bin/k3s-00-prepare-mounts.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -euo pipefail
      echo "[prepare] ensuring tmpfs mounts and fstab entries"
      # Container images live on the card: they're written only when pulled,
      # and kept in RAM they took 9 GB of this Pi's 16 and starved it. Logs
      # and each pod's scratch space, written all the time, stay in RAM.
      mkdir -p /var/lib/kubelet/pods /var/log
      add_fstab_once() {
        local line="$1"
        local mountpoint="$2"
        if ! grep -qE "^tmpfs[[:space:]]+${mountpoint}[[:space:]]+tmpfs" /etc/fstab; then
          echo "$line" >> /etc/fstab
        fi
      }
      add_fstab_once 'tmpfs /var/lib/kubelet/pods tmpfs defaults,size=20% 0 0' '/var/lib/kubelet/pods'
      add_fstab_once 'tmpfs /var/log tmpfs defaults,size=5% 0 0' '/var/log'
      mount -a || true
      echo "[mounts] after mount -a:"; findmnt -t tmpfs | sed 's/^/[mounts] /'

  # Netboot arg overlays for k3s install
  - path: /usr/local/bin/k3s-15-netboot-arguments.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -euo pipefail
      echo "[args] staging netboot-specific K3S_* argument overlays"
      ARGS_DIR="/run/k3s-bootstrap"
      mkdir -p "$ARGS_DIR"
      # The root here is plain ext4, so containerd's native overlayfs snapshotter
      # works; netboot needs fuse-overlayfs, the SD card does not. Setting
      # eviction-hard replaces the kubelet's defaults, memory's included, so
      # memory is named here: pods are evicted before the Pi runs out, and the
      # reservations keep room for the system, SSH and the kubelet.
      cat >"$ARGS_DIR/K3S_COMMON_ARGS" <<'EOF'
      --kubelet-arg=eviction-hard=memory.available<750Mi,nodefs.available<0%,imagefs.available<0%,containerfs.available<0% --kubelet-arg=system-reserved=memory=1Gi --kubelet-arg=kube-reserved=memory=512Mi --kubelet-arg=image-gc-high-threshold=70 --kubelet-arg=image-gc-low-threshold=50 --kubelet-arg=eviction-pressure-transition-period=5m --kubelet-arg=serialize-image-pulls=true --kubelet-arg=container-log-max-size=5Mi --kubelet-arg=container-log-max-files=2
      EOF
      # The SD card Pi is the server, and its datastore shares the card with
      # the images: while it pulls many at once (a first boot) writes slow, and
      # with the default 15s/10s leases the controllers lose leader election and
      # k3s exits. Longer leases ride that out.
      cat >"$ARGS_DIR/K3S_SERVER_ARGS" <<'EOF'
      --kube-controller-manager-arg=leader-elect-lease-duration=60s --kube-controller-manager-arg=leader-elect-renew-deadline=40s --kube-scheduler-arg=leader-elect-lease-duration=60s --kube-scheduler-arg=leader-elect-renew-deadline=40s --kube-cloud-controller-manager-arg=leader-elect-lease-duration=60s --kube-cloud-controller-manager-arg=leader-elect-renew-deadline=40s
      EOF

final_message: "Cloud-init for valar-0 complete. k3s installed with sdcard runtime."
